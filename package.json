{
  "name": "otgf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3010 -H localhost",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3010}",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:local:up": "docker compose up -d postgres",
    "db:local:push": "node scripts/prisma-local.mjs db push",
    "db:local:studio": "node scripts/prisma-local.mjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "next": "16.2.12",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
