# App
OPENROUTER_API_KEY=
# Optional Assist model overrides (OpenRouter ids)
# OPENROUTER_ASSIST_FAST_MODEL=google/gemini-2.5-flash
# OPENROUTER_ASSIST_MODEL=openai/gpt-4o-mini

# Supabase Postgres (Prisma) — cloud. Toggle in the floor UI (dev) to use this.
# DATABASE_URL = Transaction pooler (port 6543) — used by the app / Railway
# DIRECT_URL   = Direct connection (port 5432) — used by prisma db push / migrate
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional alias if DATABASE_URL is ever pointed at local instead.
# SUPABASE_DATABASE_URL="postgresql://..."

# Local Postgres (same Prisma schema). Default target when set.
# docker compose up -d  →  npm run db:local:push
LOCAL_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/otgf"

# Cloudflare R2 (new photo uploads). If unset, photos fall back to base64 in the DB.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=otgf
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
