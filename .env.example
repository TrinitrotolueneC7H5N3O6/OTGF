# App
OPENROUTER_API_KEY=
# Groq speech-to-text
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_CLEANUP_MODEL=openai/gpt-oss-20b
# Optional Assist model overrides (OpenRouter ids)
# OPENROUTER_ASSIST_FAST_MODEL=google/gemini-2.5-flash
# OPENROUTER_ASSIST_MODEL=openai/gpt-4o-mini
# Local development can use an installed Whisper CLI without API credit.
# WHISPER_CLI_PATH=whisper
# WHISPER_PYTHON_PATH=/path/to/python-with-whisper
# WHISPER_LOCAL_MODEL=base

# Supabase Postgres (Prisma) — cloud. Toggle in the floor UI (dev) to use this.
# DATABASE_URL = Transaction pooler (port 6543) — used by the app / Railway
# DIRECT_URL   = Direct connection (port 5432) — used by prisma db push / migrate
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional alias if DATABASE_URL is ever pointed at local instead.
# SUPABASE_DATABASE_URL="postgresql://..."

# Local Postgres (same Prisma schema). Default target when set.
# docker compose up -d  →  npm run db:local:push
LOCAL_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/otgf"

# Cloudflare R2 (new photo uploads). If unset, photos fall back to base64 in the DB.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=otgf
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Resend (transactional email). Never commit a real key.
RESEND_API_KEY=
# Must use a verified domain in production. Sandbox: OTGF <onboarding@resend.dev>
RESEND_FROM_EMAIL="OTGF <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# Twilio SMS alerts (server-only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14155551234
# Optional alternative to TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
# Optional; defaults to TWILIO_AUTH_TOKEN when omitted.
PHONE_ALERT_SIGNING_SECRET=
