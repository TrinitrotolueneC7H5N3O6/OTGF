// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  spaces       Space[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// One row per business floor. Payload is the BusinessSpace JSON.
model Space {
  slug      String   @id
  data      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id
  message   String
  email     String?
  page      String?
  userId    String?
  createdAt DateTime @default(now())
}

/// Live customer-tab heartbeats — kept off Space.data so they don't rewrite photos.
model SpacePresence {
  slug      String
  clientId  String
  presentAt DateTime

  @@id([slug, clientId])
  @@index([slug])
}
