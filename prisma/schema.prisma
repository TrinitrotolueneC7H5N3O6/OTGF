// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  spaces       Space[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Business shell — settings, library, team. No chat messages here.
model Space {
  slug      String     @id
  data      String
  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  growthRecords   GrowthRecord[]
  chats           Chat[]
  offerings       Offering[]
  knowledgeNotes  KnowledgeNote[]
  cases           CustomerCase[]
  scheduleRequests ScheduleRequest[]
  formSubmissions  FormSubmission[]
  insightSessions InsightSession[]
  insightSnapshots InsightSnapshot[]
}

/// Product or service a customer can inquire about in chat.
model Offering {
  id          String   @id
  spaceSlug   String
  space       Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  title       String
  description String   @default("")
  price       String   @default("")
  kind        String   @default("service")
  imageUrl    String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spaceSlug, sortOrder])
}

/// Plain-language facts the AI can use to answer customers.
model KnowledgeNote {
  id          String    @id
  spaceSlug   String
  space       Space     @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  /// "long" (always true) or "short" (true right now)
  horizon     String
  title       String
  body        String    @default("")
  /// Short-term only. Null means keep until the business removes it.
  expiresAt   DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([spaceSlug, horizon, sortOrder])
}

/// One row per customer conversation.
model Chat {
  id           String
  spaceSlug    String
  space        Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  customerCaseId String?
  customerCase   CustomerCase? @relation(fields: [customerCaseId], references: [id], onDelete: SetNull)
  clientData   String
  messagesData String   @default("[]")
  deleted      Boolean  @default(false)
  hiddenFromInbox Boolean @default(false)
  updatedAt    DateTime @updatedAt

  @@id([spaceSlug, id])
  @@index([spaceSlug, customerCaseId])
  @@index([spaceSlug, updatedAt])
}

/// A case groups one or more customer chats plus staff notes.
model CustomerCase {
  id        String   @id
  spaceSlug String
  space     Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  status    String   @default("open")
  notes     String   @default("")
  identifiers Json   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chats     Chat[]

  @@index([spaceSlug, status])
  @@index([spaceSlug, updatedAt])
}

/// Appointment request from a scheduler quick build.
model ScheduleRequest {
  schedulerId     String   @default("")
  timeZone        String   @default("UTC")
  startsAt        DateTime?
  endsAt          DateTime?
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  managementTokenHash String? @unique
  id              String   @id
  spaceSlug       String
  space           Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  chatId          String   @default("")
  name            String
  email           String   @default("")
  phone           String   @default("")
  date            String
  time            String
  durationMinutes Int      @default(30)
  notes           String   @default("")
  title           String   @default("")
  status          String   @default("requested")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([spaceSlug, date])
  @@index([spaceSlug, status])
  @@index([spaceSlug, createdAt])
}

/// Intake submitted from a public form.
model FormSubmission {
  id        String   @id
  spaceSlug String
  space     Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  name      String
  email     String   @default("")
  phone     String   @default("")
  title     String   @default("")
  fields    Json     @default("[]")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceSlug, createdAt])
  @@index([spaceSlug, status])
}

model Feedback {
  id        String   @id
  message   String
  email     String?
  page      String?
  userId    String?
  createdAt DateTime @default(now())
}

/// Live customer-tab heartbeats — kept off chat rows.
model SpacePresence {
  slug      String
  clientId  String
  presentAt DateTime

  @@id([slug, clientId])
  @@index([slug])
}

/// On-site visitor sessions from watch.js (Hotjar-style trails, no keystrokes).
model InsightSession {
  id          String   @id
  spaceSlug   String
  space       Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  startedAt   DateTime
  lastSeenAt  DateTime
  landingPath String   @default("/")
  referrer    String   @default("")
  device      String   @default("desktop")
  viewportW   Int      @default(0)
  viewportH   Int      @default(0)
  pageCount   Int      @default(1)
  durationMs  Int      @default(0)
  maxScroll   Int      @default(0)
  rageClicks  Int      @default(0)
  deadClicks  Int      @default(0)
  events      Json     @default("[]")

  @@index([spaceSlug, lastSeenAt])
}

/// Frozen page capture used as the heatmap background.
model InsightSnapshot {
  id         String   @id
  spaceSlug  String
  space      Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  path       String
  pageUrl    String   @default("")
  image      String
  width      Int      @default(0)
  height     Int      @default(0)
  capturedAt DateTime @default(now())

  @@unique([spaceSlug, path])
  @@index([spaceSlug])
}

/// Private program, partner, conversion, and story records. Public routes expose only published fields.
model GrowthRecord {
  id        String @id
  spaceSlug String
  space     Space @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  kind      String
  data      String
  visits    Int @default(0)
  version   Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([spaceSlug, kind])
}
