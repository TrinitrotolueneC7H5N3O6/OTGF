// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  spaces       Space[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Business shell — settings, library, team. No chat messages here.
model Space {
  slug      String   @id
  data      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chats     Chat[]
}

/// One row per customer conversation.
model Chat {
  id           String
  spaceSlug    String
  space        Space    @relation(fields: [spaceSlug], references: [slug], onDelete: Cascade)
  clientData   String
  messagesData String   @default("[]")
  deleted      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@id([spaceSlug, id])
  @@index([spaceSlug, updatedAt])
}

model Feedback {
  id        String   @id
  message   String
  email     String?
  page      String?
  userId    String?
  createdAt DateTime @default(now())
}

/// Live customer-tab heartbeats — kept off chat rows.
model SpacePresence {
  slug      String
  clientId  String
  presentAt DateTime

  @@id([slug, clientId])
  @@index([slug])
}
